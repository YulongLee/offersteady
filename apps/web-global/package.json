{
  "name": "@offersteady/web-global",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy:generate": "node scripts/generate-global-copy-strict.mjs",
    "static:generate": "node scripts/generate-review-pages.mjs",
    "dev": "npm run static:generate && npm run copy:generate && vite",
    "preview": "vite preview --host 127.0.0.1 --port 4273 --strictPort",
    "build": "npm run static:generate && npm run copy:generate && tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:copy": "npm run copy:generate && node scripts/audit-global-copy.mjs",
    "test:merchant-review": "node scripts/verify-merchant-review-pages.mjs"
  },
  "dependencies": {
    "@offersteady/config": "*",
    "@offersteady/protocol": "*",
    "@phosphor-icons/react": "^2.1.10",
    "docx": "^9.7.1",
    "katex": "^0.18.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.3",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "vite": "^8.1.0"
  }
}
