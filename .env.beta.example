# Copy to .env.beta on the Beta host. Never commit .env.beta.
BETA_RELEASE_VERSION=commercial-realtime-beta
BETA_POSTGRES_DB=offersteady_beta
BETA_POSTGRES_USER=offersteady_beta
BETA_POSTGRES_PASSWORD=replace-with-a-beta-only-password
BETA_POSTGRES_PORT=15432
BETA_REDIS_PORT=16379
BETA_BACKEND_PORT=18000
BETA_WEB_PORT=18080

# Beta may reuse provider accounts, but keys stay only in the host environment.
OFFERSTEADY_REALTIME_ASR_API_KEY=
OFFERSTEADY_REALTIME_ASR_MODEL=qwen-realtime
OFFERSTEADY_REALTIME_ASR_TURN_DETECTION_MODE=manual
OFFERSTEADY_CHAT_QWEN_API_KEY=
OFFERSTEADY_CHAT_QWEN_BASE_URL=
OFFERSTEADY_SCREENSHOT_VISION_API_KEY=

# Beta-only secrets. Do not reuse production auth/session secrets.
OFFERSTEADY_AUTH_JWT_SECRET=replace-with-beta-only-random-secret
OFFERSTEADY_AUTH_SMS_CODE_PEPPER=replace-with-beta-only-random-secret

# Optional object storage credentials. All keys are forced under the beta namespace.
OFFERSTEADY_OSS_BUCKET=
OFFERSTEADY_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OFFERSTEADY_OSS_REGION=cn-hangzhou
OFFERSTEADY_OSS_ACCESS_KEY_ID=
OFFERSTEADY_OSS_ACCESS_KEY_SECRET=
